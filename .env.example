# ============================================================
# Local Development Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to version control.
# ============================================================

# ── MongoDB ──────────────────────────────────────────────────
MONGO_INITDB_DATABASE=cybersource_tms

# ── AWS / Ministack (local SQS emulation) ────────────────────
# Dummy credentials recognised by Ministack / LocalStack-compatible APIs
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# SQS queue names created by the sqs-init service on first run
SQS_QUEUE_NAME=token-lifecycle-queue
SQS_DLQ_NAME=token-lifecycle-dlq

# ── Cybersource API credentials ───────────────────────────────
CYBERSOURCE_KEY_ID=your-key-id
CYBERSOURCE_API_KEY=your-api-key
CYBERSOURCE_SECRET_KEY=your-secret-key
CYBERSOURCE_MERCHANT_ID=your-merchant-id
# Use sandbox URL for local / integration testing
CYBERSOURCE_BASE_URL=https://apitest.cybersource.com

# ── Webhook security ─────────────────────────────────────────
WEBHOOK_SIGNATURE_SECRET=your-local-webhook-secret
